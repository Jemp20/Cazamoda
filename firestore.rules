rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: cualquiera puede VER los productos, solo el admin puede crear/editar/borrar.
    match /productos/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'joelby1234@gmail.com';
    }

    // Todo lo demás (ventas, clientes, etc.): solo el admin.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'joelby1234@gmail.com';
    }
  }
}
